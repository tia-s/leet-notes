---
import type { CollectionEntry } from 'astro:content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, summary, category, tags, date } = note.data;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/notes/${note.id}`}
  class="group bg-zinc-900/40 border border-zinc-800/80 rounded-lg p-5 hover:border-zinc-700 transition-all flex flex-col justify-between space-y-4"
>
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 bg-emerald-950/40 border border-emerald-900/50 px-2 py-0.5 rounded">
        {category === 'algorithm' ? 'Coding Problem' : 'System Design'}
      </span>
    </div>

    <h2 class="text-lg font-medium text-zinc-100 group-hover:text-emerald-300 transition-colors">
      {title}
    </h2>

    <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">
      {summary}
    </p>
  </div>

  <div class="space-y-4 pt-2">
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-[10px] font-mono bg-zinc-800/60 text-zinc-400 px-2 py-0.5 rounded border border-zinc-800">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500 border-t border-zinc-800/60 pt-3">
      <span>6 min read</span>
      <span>{formattedDate}</span>
    </div>
  </div>
</a>