---
import type { CollectionEntry } from 'astro:content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, summary } = note.data;
---

<section class="grid grid-cols-1 lg:grid-cols-12 bg-zinc-900/30 border border-zinc-800 rounded-xl overflow-hidden hover:border-zinc-700 transition-all">
  <!-- Content Pane -->
  <div class="lg:col-span-7 p-8 flex flex-col justify-between space-y-8">
    <div class="space-y-4">
      <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 block">
        From the Notebook
      </span>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-100">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
        {summary}
      </p>
    </div>

    <div class="flex items-center gap-6 text-xs font-mono text-zinc-400">
      <a
        href={`/notes/${note.id}`}
        class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-medium transition-colors group"
      >
        <span>Read the walkthrough</span>
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <span class="text-zinc-600">•</span>
      <span>6 min read</span>
    </div>
  </div>

  <!-- Graphic Pane -->
  <div class="lg:col-span-5 bg-zinc-950/60 border-t lg:border-t-0 lg:border-l border-zinc-800/80 p-8 flex items-center justify-center relative min-h-[220px]">
    <div class="absolute inset-0 bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
    <div class="relative w-32 h-32 border border-emerald-500/20 rounded-xl flex items-center justify-center bg-emerald-950/10 rotate-3">
      <div class="w-16 h-16 border border-emerald-500/40 rounded-lg flex items-center justify-center -rotate-6">
        <span class="w-3 h-3 bg-emerald-400 rounded-full animate-pulse"></span>
      </div>
    </div>
  </div>
</section>