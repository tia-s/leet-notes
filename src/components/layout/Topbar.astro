---
const currentPath = Astro.url.pathname;

let pageTitle = 'All notes';
if (currentPath.includes('/category/algorithm')) {
  pageTitle = 'Coding problems';
} else if (currentPath.includes('/category/system-design')) {
  pageTitle = 'System design';
} else if (currentPath !== '/') {
  pageTitle = 'Note view';
}
---

<header class="h-16 border-b border-zinc-800/80 px-8 flex items-center justify-between bg-zinc-950/50 backdrop-blur-sm sticky top-0 z-10">
  <div class="flex items-center gap-2 text-xs font-mono text-zinc-400">
    <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
    </svg>
    <span>Journal</span>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-200">{pageTitle}</span>
  </div>

  <div class="hidden sm:flex items-center gap-3 text-xs font-mono text-zinc-400">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
    <span>Learning, one note at a time</span>
  </div>
</header>