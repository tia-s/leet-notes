---
interface Props {
  category: 'algorithm' | 'system-design' | string;
}

const { category } = Astro.props;
const isAlgorithm = category === 'algorithm';
const isSystemDesign = category === 'system-design';
---

<div class="inline-flex items-center gap-2 text-xs font-mono tracking-wider uppercase">
  {isAlgorithm ? (
    <>
      <!-- Code brackets icon for Coding Problems -->
      <span class="text-emerald-400">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </span>
      <span class="text-emerald-400 font-medium">Coding problem</span>
    </>
  ) : isSystemDesign ? (
    <>
      <!-- Network/node icon for System Design -->
      <span class="text-purple-400">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </span>
      <span class="text-purple-400 font-medium">System design</span>
    </>
  ) : (
    <>
      <span class="text-sky-400">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
        </svg>
      </span>
      <span class="text-sky-400 font-medium">Low Level Systems</span>
    </>
  )}
</div>