---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import CategoryLabel from '../components/ui/CategoryLabel.astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, summary, category, tags, date } = note.data;
const { Content } = await render(note);
---

<BaseLayout title={title}>
  <article class="max-w-3xl mx-auto space-y-8 pb-16">
    <!-- Note Header -->
    <header class="space-y-4 border-b border-zinc-800 pb-8">
      <div class="flex items-center gap-3">
        <CategoryLabel category={category} />
        <span class="text-zinc-500 text-xs font-mono">
          {new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-100">
        {title}
      </h1>

      {summary && (
        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed">
          {summary}
        </p>
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {tags.map((tag) => (
            <Tag name={tag} />
          ))}
        </div>
      )}
    </header>

    <!-- Markdown Content Body with Clean Engineering Typography -->
    <div class="markdown-body text-zinc-300 text-sm sm:text-base leading-relaxed space-y-6">
      <Content />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .markdown-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #f4f4f5;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
  }
  .markdown-body h3 {
    font-size: 1.1rem;
    font-weight: 500;
    color: #e4e4e7;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .markdown-body p {
    margin-bottom: 1rem;
    color: #b4b4bb;
  }
  .markdown-body ul, .markdown-body ol {
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: #b4b4bb;
    list-style-position: outside;
  }
  .markdown-body ul {
    list-style-type: disc;
  }
  .markdown-body ol {
    list-style-type: decimal;
  }
  .markdown-body li {
    margin-bottom: 0.375rem;
  }
  .markdown-body table {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.875rem;
  }
  .markdown-body th,
  .markdown-body td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #27272a;
    overflow-wrap: anywhere;
    vertical-align: top;
  }
  .markdown-body th {
    color: #f4f4f5;
    font-weight: 600;
    text-align: left;
  }
  .markdown-body pre {
    background-color: #09090b !important;
    border: 1px solid #27272a;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    margin: 1.5rem 0;
  }
  .markdown-body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    color: #34d399;
  }
  .markdown-body p code {
    background-color: #18181b;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid #27272a;
  }
  .rfc-preview {
    --rfc-border: #303036;
    --rfc-toolbar: #18181b;
    --rfc-surface: #09090b;
    --rfc-accent: #6ee7b7;
    --rfc-accent-soft: #a7f3d0;
    --rfc-copy: #d4d4d8;
    --rfc-muted: #a1a1aa;
    margin: 1.5rem 0;
    border: 1px solid var(--rfc-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .rfc-preview-toolbar {
    min-height: 44px;
    padding: 0.35rem 0.5rem 0.35rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--rfc-muted);
    background: var(--rfc-toolbar);
    border-bottom: 1px solid var(--rfc-border);
    font: 0.7rem ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }
  .rfc-preview-toolbar > span {
    color: #34d399;
    font-weight: 700;
  }
  .rfc-preview-toggle {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--rfc-muted);
    background: transparent;
    border: 0;
    border-radius: 0.25rem;
    cursor: pointer;
  }
  .rfc-preview-toggle:hover,
  .rfc-preview-toggle:focus-visible {
    color: var(--rfc-accent-soft);
    background: #27272a;
  }
  .rfc-preview-toggle:focus-visible {
    outline: 2px solid var(--rfc-accent);
    outline-offset: 2px;
  }
  .rfc-preview-toggle svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rfc-preview-content,
  .rfc-source-content {
    padding: 1rem;
  }
  .rfc-preview-content {
    color: var(--rfc-copy);
    background: var(--rfc-surface);
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .rfc-preview-content h1 {
    margin: 0 0 1rem;
    color: #f4f4f5;
    font-size: 1.375rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .rfc-preview-content h2 {
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    color: #f4f4f5;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .rfc-preview-content h3 {
    margin-top: 1.5rem;
    color: #e4e4e7;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .rfc-preview-content strong {
    color: var(--rfc-accent-soft);
  }
  .rfc-preview-content li strong {
    color: var(--rfc-copy);
  }
  .rfc-preview-content p,
  .rfc-preview-content li {
    color: var(--rfc-copy);
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .rfc-preview-content p {
    margin: 0 0 0.75rem;
  }
  .rfc-preview-content ul,
  .rfc-preview-content ol {
    margin: 0 0 0.9rem;
    padding-left: 1.25rem;
    list-style-position: outside;
  }
  .rfc-preview-content ul {
    list-style-type: disc;
  }
  .rfc-preview-content ol {
    list-style-type: decimal;
  }
  .rfc-preview-content li {
    margin: 0 0 0.3rem;
    padding-left: 0.15rem;
  }
  .rfc-preview-content li > ul,
  .rfc-preview-content li > ol {
    margin-top: 0.35rem;
    margin-bottom: 0.55rem;
  }
  .rfc-preview-content > h1 + ul {
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }
  .rfc-preview-content > h1 + ul li {
    margin: 0 0 0.2rem;
    padding: 0;
    color: var(--rfc-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .rfc-preview-metadata {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 1.75rem;
    color: var(--rfc-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .rfc-preview-metadata strong {
    color: #d4d4d8;
    font-weight: 600;
  }
  .rfc-preview-content code {
    color: #34d399;
    background: #18181b;
    border: 1px solid #303036;
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
  }
  .rfc-preview-content > :first-child {
    margin-top: 0;
  }
  .rfc-preview-content > :last-child {
    margin-bottom: 0;
  }
  .rfc-source-content pre {
    background: transparent !important;
    background-color: transparent !important;
    border: 0;
    border-radius: 0;
    padding: 0;
    margin: 0;
  }
  .rfc-source-content {
    overflow-x: auto;
  }
  .rfc-source-content code {
    display: block;
    min-width: max-content;
    color: #d4d4d8 !important;
    font-size: 0.75rem;
    line-height: 1.65;
    white-space: pre;
  }
</style>

<script>
  import { marked } from 'marked';

  const rfcBlock = [...document.querySelectorAll<HTMLPreElement>('.markdown-body pre[data-language="md"]')]
    .find((pre) => pre.innerText.trimStart().startsWith('# RFC:'));

  if (rfcBlock) {
    const sourceText = rfcBlock.innerText.trim();
    const rfcTitle = sourceText.match(/^#\s+(.+)$/m)?.[1] ?? 'RFC';
    const preview = document.createElement('div');
    preview.className = 'markdown-body rfc-preview-content';
    preview.innerHTML = await marked.parse(sourceText);
    preview.querySelector('h1')?.remove();

    const metadataLines = sourceText.match(/^\*\*[^*\n]+\*\*.*$/gm) ?? [];
    if (metadataLines.length > 0) {
      const metadataParagraph = preview.querySelector('p');
      metadataParagraph?.remove();

      const metadata = document.createElement('div');
      metadata.className = 'rfc-preview-metadata';
      for (const line of metadataLines) {
        const row = document.createElement('div');
        row.innerHTML = await marked.parseInline(line);
        metadata.append(row);
      }
      preview.insertBefore(metadata, preview.firstChild);
    }

    const source = document.createElement('div');
    source.className = 'rfc-source-content';
    source.hidden = true;
    source.append(rfcBlock.cloneNode(true));

    const wrapper = document.createElement('section');
    wrapper.className = 'rfc-preview';
    wrapper.dataset.rfcPreview = '';

    const toolbar = document.createElement('div');
    toolbar.className = 'rfc-preview-toolbar';
    const label = document.createElement('span');
    label.textContent = rfcTitle;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'rfc-preview-toggle';
    button.setAttribute('aria-label', 'Show RFC source');
    button.title = 'Show source';
    button.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-5-6-2 4"/></svg>';

    const downloadButton = document.createElement('button');
    downloadButton.type = 'button';
    downloadButton.className = 'rfc-preview-toggle';
    downloadButton.setAttribute('aria-label', 'Download RFC as Markdown');
    downloadButton.title = 'Download Markdown';
    downloadButton.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg>';
    downloadButton.addEventListener('click', () => {
      const markdownFile = new Blob([sourceText], { type: 'text/markdown;charset=utf-8' });
      const downloadUrl = URL.createObjectURL(markdownFile);
      const link = document.createElement('a');
      link.href = downloadUrl;
      link.download = `${rfcTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.md`;
      link.click();
      URL.revokeObjectURL(downloadUrl);
    });

    button.addEventListener('click', () => {
      const showSource = source.hidden;
      preview.hidden = showSource;
      source.hidden = !showSource;
      button.setAttribute('aria-label', showSource ? 'Show RFC preview' : 'Show RFC source');
      button.title = showSource ? 'Show preview' : 'Show source';
      button.innerHTML = showSource
        ? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>'
        : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-5-6-2 4"/></svg>';
    });

    const actions = document.createElement('div');
    actions.className = 'flex items-center';
    actions.append(button, downloadButton);
    toolbar.append(label, actions);
    wrapper.append(toolbar, preview, source);
    rfcBlock.replaceWith(wrapper);
  }
</script>