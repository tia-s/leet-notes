---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import CategoryLabel from '../components/ui/CategoryLabel.astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, summary, category, tags, date } = note.data;
const { Content } = await render(note);
---

<BaseLayout title={title}>
  <article class="max-w-3xl mx-auto space-y-8 pb-16">
    <!-- Note Header -->
    <header class="space-y-4 border-b border-zinc-800 pb-8">
      <div class="flex items-center gap-3">
        <CategoryLabel category={category} />
        <span class="text-zinc-500 text-xs font-mono">
          {new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-100">
        {title}
      </h1>

      {summary && (
        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed">
          {summary}
        </p>
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {tags.map((tag) => (
            <Tag name={tag} />
          ))}
        </div>
      )}
    </header>

    <!-- Markdown Content Body with Clean Engineering Typography -->
    <div class="markdown-body text-zinc-300 text-sm sm:text-base leading-relaxed space-y-6">
      <Content />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .markdown-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #f4f4f5;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
  }
  .markdown-body h3 {
    font-size: 1.1rem;
    font-weight: 500;
    color: #e4e4e7;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .markdown-body p {
    margin-bottom: 1rem;
    color: #a1a1aa;
  }
  .markdown-body ul, .markdown-body ol {
    margin-left: 1.25rem;
    margin-bottom: 1rem;
    color: #a1a1aa;
  }
  .markdown-body li {
    margin-bottom: 0.375rem;
  }
  .markdown-body pre {
    background-color: #09090b !important;
    border: 1px solid #27272a;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    margin: 1.5rem 0;
  }
  .markdown-body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    color: #34d399;
  }
  .markdown-body p code {
    background-color: #18181b;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid #27272a;
  }
</style>