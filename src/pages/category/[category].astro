---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteBrowser from '../../components/notes/NoteBrowser';

export async function getStaticPaths() {
  return [
    { params: { category: 'algorithm' } },
    { params: { category: 'system-design' } },
    { params: { category: 'low-level-systems' } },
  ];
}

const category = Astro.params.category ?? '';
const categoryDetails = {
  algorithm: {
    title: 'Algorithms',
    eyebrow: 'Data structures · Techniques · Trade-offs',
    heading: 'Algorithms',
    description: 'Notes on algorithmic techniques and data structures, with specific problems as examples.',
  },
  'system-design': {
    title: 'System design',
    eyebrow: 'Architecture · Scale · Trade-offs',
    heading: 'System design',
    description: 'Notes on architecture, reliability, and trade-offs in larger systems.',
  },
  'low-level-systems': {
    title: 'Low-level systems',
    eyebrow: 'C · Go · Rust',
    heading: 'Low-level systems',
    description: 'Notes on memory, concurrency, operating systems, and implementation details.',
  },
};
const details = categoryDetails[category as keyof typeof categoryDetails];
const allNotes = await getCollection('notes');
---

<BaseLayout title={details.title}>
  <div class="space-y-12">
    <section class="space-y-4">
      <span class:list={[
        'text-xs font-mono uppercase tracking-widest',
        category === 'algorithm'
          ? 'text-orange-300'
          : category === 'low-level-systems'
            ? 'text-sky-400'
            : 'text-purple-400',
      ]}>
        {details.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-zinc-100">
        {details.heading}
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        {details.description}
      </p>
    </section>

    <NoteBrowser notes={allNotes} initialCategory={category} client:load />
  </div>
</BaseLayout>