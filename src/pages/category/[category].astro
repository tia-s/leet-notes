---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedNote from '../../components/notes/FeaturedNote.astro';
import NoteBrowser from '../../components/notes/NoteBrowser';

export async function getStaticPaths() {
  return [
    { params: { category: 'algorithm' } },
    { params: { category: 'system-design' } },
    { params: { category: 'low-level-systems' } },
  ];
}

const category = Astro.params.category ?? '';
const categoryDetails = {
  algorithm: {
    title: 'Coding Problems',
    eyebrow: 'Coding Problems',
    heading: 'Algorithmic thinking.',
    description: 'Focused notes and breakdowns on data structures and algorithmic patterns.',
  },
  'system-design': {
    title: 'System Design',
    eyebrow: 'System Design Architecture',
    heading: 'Distributed systems.',
    description: 'Focused notes and breakdowns on scalable architecture and system design.',
  },
  'low-level-systems': {
    title: 'Low Level Systems',
    eyebrow: 'C · Go · Rust',
    heading: 'Closer to the machine.',
    description: 'Systems questions explored through memory, concurrency, operating systems, and implementation.',
  },
};
const details = categoryDetails[category as keyof typeof categoryDetails];
const allNotes = await getCollection('notes');
const categoryNotes = allNotes.filter((note) => note.data.category === category);
const featuredNote = categoryNotes[0];
---

<BaseLayout title={`LeetNotes: Engineering Journal - ${details.title}`}>
  <div class="space-y-12">
    <section class="space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">
        {details.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-zinc-100">
        {details.heading}
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        {details.description}
      </p>
    </section>

    {featuredNote && <FeaturedNote note={featuredNote} />}
    <NoteBrowser notes={allNotes} initialCategory={category} client:load />
  </div>
</BaseLayout>