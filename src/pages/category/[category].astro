---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedNote from '../../components/notes/FeaturedNote.astro';
import NoteBrowser from '../../components/notes/NoteBrowser';

export async function getStaticPaths() {
  return [
    { params: { category: 'algorithm' } },
    { params: { category: 'system-design' } },
    { params: { category: 'low-level-systems' } },
  ];
}

const category = Astro.params.category ?? '';
const categoryDetails = {
  algorithm: {
    title: 'Coding Problems',
    eyebrow: 'Patterns · Logic · Algorithms',
    heading: 'Think in patterns.',
    description: 'Coding problems explored through algorithms, data structures, and understanding the reasoning behind efficient solutions.',
  },
  'system-design': {
    title: 'System Design',
    eyebrow: 'Architecture · Scale · Trade-offs',
    heading: 'Design for scale.',
    description: 'System designs that balance reliability, performance, and complexity as services grow.',
  },
  'low-level-systems': {
    title: 'Low Level Systems',
    eyebrow: 'C · Go · Rust',
    heading: 'Closer to the machine.',
    description: 'Systems questions explored through memory, concurrency, operating systems, and implementation.',
  },
};
const details = categoryDetails[category as keyof typeof categoryDetails];
const allNotes = await getCollection('notes');
const categoryNotes = allNotes.filter((note) => note.data.category === category);
const featuredNote = categoryNotes.find((note) => note.data.featured);
---

<BaseLayout title={`LeetNotes: Engineering Journal - ${details.title}`}>
  <div class="space-y-12">
    <section class="space-y-4">
      <span class:list={[
        'text-xs font-mono uppercase tracking-widest',
        category === 'algorithm'
          ? 'text-orange-300'
          : category === 'low-level-systems'
            ? 'text-sky-400'
            : 'text-purple-400',
      ]}>
        {details.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-zinc-100">
        {details.heading}
      </h1>
      <p class="text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        {details.description}
      </p>
    </section>

    {featuredNote && <FeaturedNote note={featuredNote} />}
    <NoteBrowser notes={categoryNotes} initialCategory={category} client:load />
  </div>
</BaseLayout>