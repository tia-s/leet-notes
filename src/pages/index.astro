---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedNote from '../components/notes/FeaturedNote.astro';
import NoteBrowser from '../components/notes/NoteBrowser.tsx';
import { sortNotesByDate } from '../lib/notes';

const allNotesRaw = await getCollection('notes');
const notes = sortNotesByDate(allNotesRaw);

// Fallback to the first note if none are explicitly marked as featured
const featuredNote = notes.find((note) => note.data.featured) || notes[0];
---

<BaseLayout title="Engineering Journal - All notes">
  <div class="space-y-12">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-zinc-800 pb-8">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 block mb-2">
          Tianna's Engineering Journal
        </span>
        <h1 class="text-4xl font-semibold tracking-tight text-zinc-100">
          Notes to think with.
        </h1>
        <p class="text-zinc-400 mt-2 text-sm sm:text-base">
          Exploring algorithms, system architecture, and low-level engineering.
        </p>
      </div>
    </header>

    {featuredNote && <FeaturedNote note={featuredNote} />}

    <section>
      <NoteBrowser notes={notes} client:load />
    </section>
  </div>
</BaseLayout>